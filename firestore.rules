rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- User profile & check-ins (per account) ----
    match /users/{userId} {
      // Only the owner can read/create/update their own profile.
      allow read, create, update: if request.auth != null && request.auth.uid == userId;

      // createdAt must be stable once set.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt == resource.data.createdAt);

      match /checkins/{checkinId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;

        allow update: if request.auth != null
          && request.auth.uid == userId
          && (!request.resource.data.keys().hasAny(['createdAt'])
              || request.resource.data.createdAt == resource.data.createdAt);
      }
    }

    // ---- Global community feed (anonymous) ----
    match /community_posts/{postId} {
      // Any signed-in user can read the feed.
      allow read: if request.auth != null;

      // Any signed-in user can publish a post with a valid shape.
      allow create: if request.auth != null
        && request.resource.data.authorAlias is string
        && request.resource.data.contentEn is string
        && request.resource.data.contentAr is string
        && request.resource.data.daysClean is int
        && request.resource.data.category is string
        && request.resource.data.timestampMillis is int
        && request.resource.data.fistBumps is int;

      // Only the fist-bump counter may change after creation.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fistBumps']);

      allow delete: if false;
    }
  }
}