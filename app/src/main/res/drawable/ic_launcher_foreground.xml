<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a shield (protection) with a sprout (recovery).
  Everything is kept inside the 66dp safe zone (x/y 21..87) so no part of the mark is
  clipped by the launcher's mask, and it is a vector, so there is no 1 MB JPEG to ship.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield body -->
    <path
        android:fillColor="#10B981"
        android:pathData="M54,24 L77,32.5 L77,52 C77,68.5 67,79 54,85 C41,79 31,68.5 31,52 L31,32.5 Z" />

    <!-- Inner shield face, slightly darker for depth -->
    <path
        android:fillColor="#0E9F6E"
        android:pathData="M54,29.5 L72.5,36.3 L72.5,52 C72.5,65 64.5,74 54,79.4 C43.5,74 35.5,65 35.5,52 L35.5,36.3 Z" />

    <!-- Stem -->
    <path
        android:strokeColor="#ECFDF5"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,71 C54,62 54,55 54,47" />

    <!-- Left leaf -->
    <path
        android:fillColor="#ECFDF5"
        android:pathData="M53.5,57 C47,57 42.5,52.6 42.5,46 C49,46 53.5,50.4 53.5,57 Z" />

    <!-- Right leaf, slightly higher -->
    <path
        android:fillColor="#ECFDF5"
        android:pathData="M54.5,51 C54.5,43.6 59.9,38.6 67,38.6 C67,46 61.6,51 54.5,51 Z" />
</vector>
