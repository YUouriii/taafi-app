<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the site's favicon — a burnt-sienna half-sun rising
  over an ink baseline ("a recovery journal at dawn"). Geometry is scaled from
  public/favicon.svg into the 66dp safe zone (x/y 21..87) so the launcher's
  mask never clips the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rising half-sun -->
    <path
        android:fillColor="#C14E24"
        android:pathData="M32.5,59.4 A21.5,21.5 0 0 1 75.5,59.4 Z" />

    <!-- Ink baseline -->
    <path
        android:fillColor="#211D16"
        android:pathData="M26,65.8 h56 a2.15,2.15 0 0 1 2.15,2.15 v0 a2.15,2.15 0 0 1 -2.15,2.15 h-56 a2.15,2.15 0 0 1 -2.15,-2.15 v0 a2.15,2.15 0 0 1 2.15,-2.15 Z" />
</vector>
